{
  "name": "@arimsc/arim-mcp",
  "version": "0.1.0",
  "description": "MCP server for ARIM Air Monitoring System - device, measurement data, statistics, correction, report (read-only)",
  "type": "module",
  "bin": {
    "arim-mcp": "build/index.js"
  },
  "main": "./build/index.js",
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js"
  },
  "keywords": [
    "mcp",
    "arim",
    "air-quality",
    "monitoring",
    "claude"
  ],
  "author": "HubInSoft",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
